{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "defaultMode": "acceptEdits"
  },
  "preferredNotifChannel": "terminal_bell",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skipWorkflowUsageWarning": true,
  "verbose": true
}
