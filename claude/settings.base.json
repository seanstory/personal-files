{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__playwright__*",
      "mcp__memory-researcher__recall",
      "mcp__memory-researcher__retain",
      "mcp__memory-architect__recall",
      "mcp__memory-architect__retain",
      "mcp__memory-product-manager__recall",
      "mcp__memory-product-manager__retain"
    ],
    "defaultMode": "acceptEdits"
  },
  "preferredNotifChannel": "terminal_bell",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skipWorkflowUsageWarning": true,
  "verbose": true
}
